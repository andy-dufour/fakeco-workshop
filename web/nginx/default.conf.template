# Rendered by the nginx image at start (envsubst) into /etc/nginx/conf.d/default.conf.
# Variables: API_UPSTREAM (for example http://concierge-api:8080)
#            OTLP_UPSTREAM (for example http://otel-collector:4318)
#            GATE_UPSTREAM (the demo gate, python -m fakeco.gate serve; a sidecar of the pod: http://127.0.0.1:8090)
# Only those three are substituted (see NGINX_ENVSUBST_FILTER in the Dockerfile);
# nginx's own $variables stay as they are.
#
# Two listeners. 8080 is the public one: a username and password are needed for the pages and /api (the gate asks for them, see
# services/fakeco/gate.py), and not for /otlp/ and /healthz. 8081 has no gate and only a ClusterIP Service (web-internal) reaches it:
# the browser load generator uses it, so that it needs no password.

# The gate's cookie only gets the Secure flag over https; the Box's public URL ends TLS before nginx and says so in X-Forwarded-Proto.
map $http_x_forwarded_proto $gate_proto {
    default $scheme;
    https   https;
}

server {
    listen 8080;
    server_name _;
    # The redirect to the form must not name port 8080: the public URL (the Box's, or a NodePort) has another one.
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # Kubernetes probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The gate: the sign-in form (GET /gate/login), the sign-in call for apps (POST /gate/login) and sign-out. Open to everyone.
    location /gate/ {
        proxy_pass ${GATE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gate_proto;
    }

    # Asks the gate whether the request has a valid cookie `fakeco_gate` or header `X-Gate-Token`. 204 passes, 401 does not, and
    # anything else (the gate is down) stops the request too.
    location = /_gate_verify {
        internal;
        proxy_pass ${GATE_UPSTREAM}/_verify;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # A page request without a valid token goes to the form; an API request gets a 401 that the app and the mobile apps can tell from
    # the app's own "sign in again" by its code.
    location @gate_form {
        return 302 /gate/login?next=$uri;
    }
    location @gate_api {
        default_type application/json;
        return 401 '{"error":{"code":"gate_required","message":"Sign in to the demo first (POST /gate/login)."}}';
    }

    # Public API: the path is kept. The chat endpoint can take up to 5 min (concierge-api gives up after 300 s).
    location /api/ {
        auth_request /_gate_verify;
        error_page 401 = @gate_api;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
    }

    # Browser and mobile telemetry: /otlp/v1/traces and /otlp/v1/logs -> ${OTLP_UPSTREAM}/v1/... Not behind the gate: the sign-in
    # page and the apps send before anyone has signed in.
    location /otlp/ {
        proxy_pass ${OTLP_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 4m;
        proxy_read_timeout 30s;
    }

    # Hashed build assets can be cached for a long time.
    location /assets/ {
        auth_request /_gate_verify;
        error_page 401 = @gate_form;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: every other path falls back to index.html.
    location / {
        auth_request /_gate_verify;
        error_page 401 = @gate_form;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

server {
    listen 8081;
    server_name _;
    # No gate here: see the top of this file.

    root /usr/share/nginx/html;
    index index.html;

    # Kubernetes probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Public API: the path is kept. The chat endpoint can take up to 5 min (concierge-api gives up after 300 s).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
    }

    # Browser telemetry: /otlp/v1/traces and /otlp/v1/logs -> ${OTLP_UPSTREAM}/v1/...
    location /otlp/ {
        proxy_pass ${OTLP_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 4m;
        proxy_read_timeout 30s;
    }

    # Hashed build assets can be cached for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: every other path falls back to index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
